    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.24",
    "jsdom": "^29.0.1",
    "lefthook": "^2.1.10",
    "msw": "^2.12.14",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.7.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10"
  },
  "optionalDependencies": {
    "@rolldown/binding-win32-x64-msvc": "^1.2.3"
