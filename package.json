{
  "name": "Auspira",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "next dev --turbo",
    "dev:webpack": "next dev",
    "postinstall": "node scripts/copy-pdf-worker.mjs",
    "prebuild": "node scripts/copy-pdf-worker.mjs",
    "prepare": "node scripts/install-hooks.mjs",
    "build": "npm run quality:ci && npm run test && next build",
    "build:fast": "npm run prebuild && next build",
    "analyze": "ANALYZE=true next build",
    "start:dev": "node run-next.js start",
    "start": "node run-next.js start",
    "lint": "biome lint",
    "check-types": "tsc --pretty --noEmit",
    "check-format": "biome format",
    "check-lint": "biome lint",
    "format": "biome format --write",
    "quality:ci": "npm run check-types",
    "quality": "npm run format && npm run check-format && npm run check-lint && npm run check-types",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@ant-design/cssinjs": "^2.1.2",
    "@ant-design/icons": "^6.1.0",
    "@ant-design/nextjs-registry": "^1.3.0",
    "@ant-design/v5-patch-for-react-19": "^1.0.3",
    "@hello-pangea/dnd": "^18.0.1",
    "@iconify/react": "^6.0.2",
    "@react-google-maps/api": "^2.20.8",
    "@tailwindcss/postcss": "^4.2.1",
    "@tanstack/react-query": "^5.67.2",
    "@tanstack/react-query-devtools": "^5.67.2",
    "antd": "^6.3.0",
    "axios": "^1.16.0",
    "dayjs": "^1.11.20",
    "framer-motion": "^12.38.0",
    "js-cookie": "^3.0.5",
    "localstorage-slim": "^2.7.1",
    "lucide-react": "^0.575.0",
    "next": "^15.1.7",
    "next-auth": "^4.24.11",
    "nextjs-toploader": "^3.9.17",
    "polished": "^4.3.1",
    "react": "^19.0.0",
    "react-country-flag": "^3.1.0",
    "react-dom": "^19.0.0",
    "react-draggable": "^4.5.0",
    "react-otp-input": "^3.1.1",
    "react-pdf": "^10.4.1",
    "react-signature-canvas": "^1.1.0-alpha.2",
    "react-toastify": "^11.0.5",
    "recharts": "^3.8.1",
    "zustand": "^5.0.3"
